# ==============================================================================
# AWS Configuration
# ==============================================================================
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
# Optional: if using temporary session credentials (e.g., AWS SSO / STS / AssumeRole)
AWS_SESSION_TOKEN=

# ==============================================================================
# AWS Bedrock Settings
# ==============================================================================
# Model ID configured per plan.md and user selection
BEDROCK_MODEL_ID=us.amazon.nova-2-lite-v1:0
# Thinking effort for Amazon Nova 2 models (valid values: low, medium, high, or empty/disabled to disable)
BEDROCK_THINKING_EFFORT=low

# ==============================================================================
# AWS DynamoDB Settings
# ==============================================================================
DYNAMODB_TABLE_REFUNDS=refund-requests
DYNAMODB_TABLE_ORDERS=mock-orders
DYNAMODB_TABLE_CHECKPOINTS=langgraph-checkpoints
# Optional: leave empty for AWS Cloud; set to http://localhost:8000 only if using DynamoDB Local
DYNAMODB_ENDPOINT_URL=

# ==============================================================================
# LangSmith Observability & Tracing
# ==============================================================================
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=refund-request-processor

# ==============================================================================
# Application & Server Settings
# ==============================================================================
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
